{
	"name": "datavideo-visca",
	"version": "2.0.0",
	"main": "dist/main.js",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-datavideo-visca.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~1.14.1"
	},
	"devDependencies": {
		"@companion-module/tools": "^2.7.1",
		"@types/node": "^22.19.3",
		"eslint": "^9.39.3",
		"prettier": "^3.8.1",
		"rimraf": "^6.1.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.51.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"scripts": {
		"format": "prettier -w .",
		"lint:raw": "eslint",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint": "yarn lint:raw .",
		"package": "yarn build && companion-module-build",
		"mock": "node --watch tools/dvip-mock.js & node --watch tools/http-mock.js 8180 & wait",
		"mock:dvip": "node --watch tools/dvip-mock.js",
		"mock:http": "node --watch tools/http-mock.js 8180"
	}
}
